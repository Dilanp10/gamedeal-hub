# Copiar a `.env` y completar. Nunca commitear `.env`.

# Puerto HTTP del servidor Fastify
PORT=3000

# Entorno: development | test | production
NODE_ENV=development

# RAWG API — obtener gratis en https://rawg.io/apidocs
RAWG_API_KEY=

# CheapShark no requiere API key (dejar variable para futura configuración)
CHEAPSHARK_BASE_URL=https://www.cheapshark.com/api/1.0
RAWG_BASE_URL=https://api.rawg.io/api

# Timeouts (ms) para upstreams
UPSTREAM_TIMEOUT_MS=5000

# Nivel de log: fatal|error|warn|info|debug|trace
LOG_LEVEL=info
